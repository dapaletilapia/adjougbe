# Variables de production à recopier dans .env.docker (secrets) et .env (compose). Ne jamais versionner.
# --- .env (docker compose) ---
DOMAIN=adjougbe.ci
POSTGRES_DB=adjougbe
POSTGRES_USER=adjougbe
POSTGRES_PASSWORD=a-generer
BACKUP_DIR=/srv/adjougbe/backups
BACKUP_RETENTION_DAYS=14

# --- .env.docker (application) ---
ENVIRONMENT=production
DEBUG=0
SECRET_KEY=a-generer
CONTENT_ENCRYPTION_KEY=a-generer-et-sauvegarder-hors-serveur
ALLOWED_HOSTS=adjougbe.ci,www.adjougbe.ci,backend
CSRF_TRUSTED_ORIGINS=https://adjougbe.ci
CORS_ALLOWED_ORIGINS=https://adjougbe.ci
FRONTEND_URL=https://adjougbe.ci
BACKEND_PUBLIC_URL=https://adjougbe.ci
SECURE_SSL_REDIRECT=0
SECURE_COOKIES=1
PAYMENT_PROVIDER=cinetpay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Adjougbe <bonjour@adjougbe.ci>
