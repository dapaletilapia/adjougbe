# Copier en .env.docker et compléter. Ne jamais versionner ce fichier.
ENVIRONMENT=staging
DEBUG=0
SECRET_KEY=a-generer
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# À SAUVEGARDER : sans cette clé, le contenu chiffré des livres est perdu.
CONTENT_ENCRYPTION_KEY=a-generer
ALLOWED_HOSTS=localhost,127.0.0.1,backend,recette.adjougbe.ci
CSRF_TRUSTED_ORIGINS=http://localhost:8080,https://recette.adjougbe.ci
CORS_ALLOWED_ORIGINS=http://localhost:8080
FRONTEND_URL=http://localhost:8080
BACKEND_PUBLIC_URL=http://localhost:8080
# En local sur http://, désactiver la redirection HTTPS ; en ligne derrière HTTPS, mettre 1.
SECURE_SSL_REDIRECT=0
SECURE_COOKIES=0
PAYMENT_PROVIDER=simulated
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Adjougbe <bonjour@adjougbe.ci>
GOOGLE_CLIENT_ID=
