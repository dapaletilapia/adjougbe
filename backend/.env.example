# --- Environnement : development | staging (recette) | production
ENVIRONMENT=development
DEBUG=1
SECRET_KEY=change-me
# Clé Fernet (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
# NE JAMAIS la perdre : sans elle, le contenu chiffré des livres est illisible.
CONTENT_ENCRYPTION_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL en recette / production
# DATABASE_URL=postgres://adjougbe:motdepasse@localhost:5432/adjougbe
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
PRIVATE_STORAGE_ROOT=
# --- Paiement : simulated | cinetpay
PAYMENT_PROVIDER=simulated
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
# --- E-mails (Brevo SMTP, Postmark…)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Adjougbe <bonjour@adjougbe.ci>
GOOGLE_CLIENT_ID=
# --- Règles métier
MAX_DEVICES_PER_ACCOUNT=2
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SESSION_INACTIVITY_TIMEOUT=7200
READER_URL_TTL_SECONDS=120
READER_MAX_PAGES_PER_HOUR=400
